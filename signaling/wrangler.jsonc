{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holo-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "env": {
    "preview": {
      "name": "holo-p2p-preview",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
      },
      "vars": {
        "ORIGINS": "http://localhost:3000,http://localhost:3001,https://holo-git-feat-p2p-transfers-cs30.vercel.app,https://holo-7vcqo1d9s-cs30.vercel.app",
        "TURN_ENABLED": "true"
      }
    }
  },
  "vars": {
    // Comma-separated exact origins. No wildcard is supported: an unlisted
    // origin (or a missing Origin header) is rejected with 403.
    "ORIGINS": "http://localhost:3000",
    // TURN is off by default. Set to "true" and add the two secrets below.
    "TURN_ENABLED": "false"
  }
}
